USE_MOCKS=false
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=SET_IN_PROCESS_ENV
INTAKE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
LLM_MODEL=local-model
AGENT_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_API_KEY=SET_IN_PROCESS_ENV
AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
API_HOST=127.0.0.1
API_PORT=8001
VITE_API_URL=http://127.0.0.1:8001
# Scheduler (Person 4): auto tries cuopt > ortools > mock
SCHEDULER=auto
SCHEDULER_ADAPTER=auto
SCHEDULER_ALLOW_FALLBACK=true
# demo = fixture day starting at SCHEDULER_DEMO_START; real = wall clock
SCHEDULER_CLOCK=demo
SCHEDULER_DEMO_START=11:00
SCHEDULER_DEMO_SPEED=1
