USE_MOCKS=false
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=SET_IN_PROCESS_ENV
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
INTAKE_MODEL=VERIFY_hosted_omni_model_id
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_URL=http://127.0.0.1:8000
# Scheduler (Person 4): auto tries cuopt > ortools > mock
SCHEDULER=auto
SCHEDULER_TIME_LIMIT_S=1.0
# demo = fixture day starting at SCHEDULER_DEMO_START; real = wall clock
SCHEDULER_CLOCK=demo
SCHEDULER_DEMO_START=11:00
SCHEDULER_DEMO_SPEED=1
