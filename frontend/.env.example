# Copy to frontend/.env.local to change these. See README "Run HomeShield on two devices".
# api (default): FastAPI over HTTP + SSE through the /api dev proxy. local: in-browser data, no backend.
VITE_DATA_MODE=api
# Where the dev servers proxy /api (the browser never calls this URL directly).
VITE_BACKEND_URL=http://127.0.0.1:8001
