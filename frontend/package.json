{
  "name": "homeshield-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:resident": "vite --mode resident",
    "dev:resident:https": "vite --mode resident",
    "dev:staff": "vite --mode staff",
    "build": "tsc -b && vite build --mode resident && vite build --mode staff",
    "build:resident": "vite build --mode resident",
    "build:staff": "vite build --mode staff",
    "preview:resident": "vite preview --mode resident --outDir dist/resident",
    "preview:staff": "vite preview --mode staff --outDir dist/staff",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@deck.gl/layers": "^9.2.5",
    "@deck.gl/mapbox": "^9.2.5",
    "@deck.gl/react": "^9.2.5",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.11",
    "vitest": "^5.1.0"
  }
}
