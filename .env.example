USE_MOCKS=true
DATABASE_PATH=homeshield.sqlite3
DEMO_SEED=false
AGENT_RUNTIME=mock
INTAKE_ADAPTER=mock
UPLOAD_DIRECTORY=data/uploads
MAX_PHOTO_UPLOAD_BYTES=10485760
MAX_AUDIO_UPLOAD_BYTES=26214400
INTAKE_AUDIO_ENABLED=false
SCHEDULER_ADAPTER=mock
SCHEDULER_TIME_LIMIT_S=1.0
SCHEDULER_SEED_JOBS=true
SCHEDULER_ALLOW_FALLBACK=true
SCHEDULER_CLOCK=demo
SCHEDULER_DEMO_START=11:00
SCHEDULER_DEMO_SPEED=1
NEMOCLAW_URL=
COMPONENT_TIMEOUT_SECONDS=20
AGENT_MAX_ITERATIONS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Nano Omni intake. Laptop default assumes: ssh -L 18000:localhost:8000 user@<spark-ip>
LLM_BASE_URL=http://127.0.0.1:18000/v1
LLM_API_KEY=
# LLM_MODEL is the backward-compatible model-name fallback for both explicit names below.
LLM_MODEL=local-model
INTAKE_MODEL=nemotron_3_nano_omni
# Nemotron Lightning Python-agent fallback (Ollama OpenAI-compatible API).
AGENT_BASE_URL=http://127.0.0.1:11434/v1
AGENT_API_KEY=
AGENT_MODEL=VERIFY_nemotron_lightning_ollama_tag
AGENT_ENABLE_THINKING=false
AGENT_CHAT_TEMPLATE_CONTROL=auto
API_HOST=127.0.0.1
# Port 8000 belongs to Nano Omni on Spark; use 8001 for FastAPI.
API_PORT=8001
VITE_API_URL=http://127.0.0.1:8001
# Scheduler (Person 4): auto tries cuopt > ortools > mock
SCHEDULER=auto
# demo = fixture day starting at SCHEDULER_DEMO_START; real = wall clock
SCHEDULER_CLOCK=demo
SCHEDULER_DEMO_START=11:00
SCHEDULER_DEMO_SPEED=1
