USE_MOCKS=true
DATABASE_PATH=homeshield.sqlite3
DEMO_SEED=false
AGENT_RUNTIME=mock
INTAKE_ADAPTER=mock
UPLOAD_DIRECTORY=data/uploads
MAX_PHOTO_UPLOAD_BYTES=10485760
MAX_AUDIO_UPLOAD_BYTES=26214400
INTAKE_AUDIO_ENABLED=false
SCHEDULER_ADAPTER=mock
SCHEDULER_TIME_LIMIT_S=1.0
SCHEDULER_SEED_JOBS=true
SCHEDULER_CLOCK=demo
SCHEDULER_DEMO_START=11:00
SCHEDULER_DEMO_SPEED=1
NEMOCLAW_URL=
COMPONENT_TIMEOUT_SECONDS=20
AGENT_MAX_ITERATIONS=8
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=local-model
INTAKE_MODEL=local-vision-model
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_URL=http://127.0.0.1:8000
# Scheduler (Person 4): auto tries cuopt > ortools > mock
SCHEDULER=auto
SCHEDULER_TIME_LIMIT_S=1.0
# demo = fixture day starting at SCHEDULER_DEMO_START; real = wall clock
SCHEDULER_CLOCK=demo
SCHEDULER_DEMO_START=11:00
SCHEDULER_DEMO_SPEED=1
